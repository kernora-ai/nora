# Kernora — AI Work Intelligence
# Elastic License 2.0 — commercial use requires agreement with kernora.ai
# https://github.com/kernora-ai/nora/blob/main/LICENSE
#
# Copy to ~/.kernora/config.toml  (install.sh does this automatically)

[mode]
type = "byok"
# "byok"   = your key, your machine — zero bytes to Kernora (default)
# "team"   = local analysis + structured sync to your S3 bucket (coming soon)

[model]
provider = "auto"
# "auto"      = detects available keys, picks best model per tier (RECOMMENDED)
# "ide"       = defers to IDE-provided LLM (Kiro, Cursor, VS Code)
# "local"     = Apple FoundationModels (macOS 26+) or MLX-LM server
# "anthropic" = ANTHROPIC_API_KEY → Sonnet 4.6 (deep) + Haiku 4.5 (classify)
# "google"    = GEMINI_API_KEY → Gemini 3.1 Pro (deep) + Gemini 3 Flash (classify)
# "openai"    = OPENAI_API_KEY → GPT-4o (deep) + GPT-4o-mini (classify)
# "bedrock"   = AWS_PROFILE → Nova Pro (adequate) + Nova Lite (basic)
# "grok"      = XAI_API_KEY → Grok Beta
# "ollama"    = localhost:11434 → local models (free but limited quality)

[bedrock]
region = "us-east-1"
model  = "amazon.nova-pro-v1:0"

[google]
model = "gemini-3.1-pro-preview"

[openai]
model = "gpt-4o"

[grok]
model = "grok-beta"

[ollama]
model = "llama3.2:8b"
host  = "http://localhost:11434"

# [local]
# prefer = "auto"              # "auto" | "foundationmodels" | "mlx"
# foundationmodels_port = 2744 # Apple FoundationModels (macOS 26+)
# mlx_port = 2745              # MLX-LM Qwen2.5-Coder-3B (macOS 14+)

[analysis]
run_every_minutes  = 60
max_sessions_per_run = 20

[dashboard]
port     = 2742
auto_open = true

[privacy]
verified = true
# Confirms Kernora receives zero data in byok mode.
# Verified by network audit during install.

[capture]
# Live Capture pipeline — all 3 triggers default-on. Flip to false to disable.
auto_enabled           = true
auto_interval_minutes  = 60      # hourly; fires only with substantive turns since last capture
auto_min_new_turns     = 8
auto_max_per_day       = 4
precompact_enabled     = true    # pre-compact hook, fire-and-forget (<250 ms)
notify_threshold_pending = 5     # badge appears at this pending count

[bridge]
# Confidence threshold for facts written to ~/.claude/projects/<p>/memory/nora-intelligence.md
# via nora_claude_memory(write=True). Only facts at confidence >= this value are exported.
# Range: 0.0 (export everything) to 1.0 (export nothing). Default: 0.85.
min_confidence = 0.85
